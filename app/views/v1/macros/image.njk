{% macro image(type, classes ) %}

    <!-- EXPANDER IMAGE SCRIPT -->
    <script>

        'use strict';

        const ExpanderImage = (function(){

            //
            // SETTINGS
            // 
            const _fields = {};

            _fields.firstName = { x: 61, y: 935, width: 1012, height: 56 };
            _fields.lastName = { x: 61, y: 885, width: 1012, height: 56, };

            _fields.dateOfBirth = { x: 567, y: 1138, width: 596, height: 118 };
            _fields.nhsNumber = { x: 76, y: 1286, width: 1086, height: 106 };

            _fields.houseNumber = { x: 76, y: 958, width: 1086, height: 100 };
            _fields.street = { x: 76, y: 1008, width: 1086, height: 100 };
            _fields.town = { x: 76, y: 1098, width: 1086, height: 100 };
            _fields.postcode = { x: 76, y: 1148, width: 492, height: 100 };

            _fields.address = { x: 76, y: 958, width: 1086, height: 298 };

            _fields.telephoneNumber = { x: 76, y: 1198, width: 1086, height: 100 };
            _fields.emailAddress = { x: 76, y: 1248, width: 1086, height: 100 };
            
            _fields.childsDueOrBirthDate = { x: 566, y: 1448, width: 596, height: 86 };

            _fields.patientSignature = { x: 1164, y: 684, width: 1116, height: 86 };
            _fields.healthcarePractitionerSignature = { x: 1164, y: 958, width: 1116, height: 86 };

            _fields.healthcarePractitionerDetails = { x: 1164, y: 700, width: 1116, height: 558 };

            _fields.healthcarePractitionerName = { x: 1164, y: 1148, width: 1116, height: 100 };

            _fields.healthcarePractitionerAddress = { x: 1164, y: 1274, width: 1116, height: 400 };

            _fields.healthcarePractitionerStamp = { x: 1916, y: 1044, width: 364, height: 482 };


            //
            // MEDEX FIELDS 
            //
            const _fieldsMedex = {};
                _fieldsMedex.firstName = { x: 1180, y: 286, width: 1095, height: 65 };
                _fieldsMedex.lastName  = { x: 1180, y: 236, width: 1095, height: 65 };

                _fieldsMedex.houseNumber = { x: 1180, y: 326, width: 1095, height: 65 };
                _fieldsMedex.street      = { x: 1180, y: 376, width: 1095, height: 65 };

                _fieldsMedex.addressLine2 = { x: 1180, y: 426, width: 1095, height: 70 };

                _fieldsMedex.town     = { x: 1180, y: 476, width: 1095, height: 65 };
                _fieldsMedex.postcode = { x: 1180, y: 526, width: 500, height: 65 };

                _fieldsMedex.dateOfBirth = { x: 1680, y: 526, width: 700, height: 65 };

                _fieldsMedex.telephoneNumber = { x: 1180, y: 576, width: 1095, height: 65 };
                _fieldsMedex.emailAddress    = { x: 1180, y: 626, width: 1095, height: 65 };

                _fieldsMedex.nhsNumber = { x: 1180, y: 652, width: 1000, height: 80 };

                _fieldsMedex.permanentFistula = { x: 80, y: 606, width: 1100, height: 85 };
                _fieldsMedex.epilepsy = { x: 80, y: 696, width: 1100, height: 65 };
                _fieldsMedex.diabetesMellitus = { x: 80, y: 746, width: 1100, height: 65 };
                _fieldsMedex.myxoedema = { x: 80, y: 796, width: 1100, height: 65 };
                _fieldsMedex.hypoparathyroidism = { x: 80, y: 846, width: 1100, height: 65 };
                _fieldsMedex.diabetesInsipidus = { x: 80, y: 896, width: 1100, height: 65 };
                _fieldsMedex.formsOfHypoadrenalism = { x: 80, y: 946, width: 1100, height: 85 };
                _fieldsMedex.myastheniaGravis = { x: 80, y: 1036, width: 1100, height: 65 };
                _fieldsMedex.continuingPhysicalDisability = { x: 80, y: 1086, width: 1100, height: 125 };
                _fieldsMedex.cancer = { x: 80, y: 1266, width: 1100, height: 125 };

                _fieldsMedex.patientSignature = { x: 1550, y: 1350, width: 700, height: 120 };

                _fieldsMedex.healthcarePractitionerDetails = { x: 1550, y: 1500, width: 700, height: 500 };

            //
            // INIT FUNCTION
            //
            function _init(){

                console.log('ExpanderImage.init();');

                _initFocusElements();

                    function addMidpoints(fieldSet){
                    Object.keys(fieldSet).forEach(function(key){
                        fieldSet[key].midPointX = Math.round(fieldSet[key].x + (fieldSet[key].width / 2));
                        fieldSet[key].midPointY = Math.round(fieldSet[key].y + (fieldSet[key].height / 2));
                    });
                    }

                    addMidpoints(_fields);
                    addMidpoints(_fieldsMedex);


                const expander = document.querySelector( '.expandable-image' );
                expander.querySelector('.expandable-image__button').addEventListener('click',function(){
                    _resetImage();
                });

                window.addEventListener( 'resize', function(){
                    _resetImage();
                    _checkForFocusedElements();
                });

               _checkForFocusedElements();

            }

            //
            // INIT FOCUS ELEMENTS FUNCTION
            //
            function _initFocusElements(){

                const focusCues = document.querySelectorAll('[data-focus-image]');

                const blursActive = true;
                const mouseOutsActive = false;

                if( focusCues.length > 0 ){

                    focusCues.forEach(function( el ){


                        //
                        // TABLE ROWS
                        //
                        if( el.matches('.nhsuk-table') ){

                            const focusFields = ( el.getAttribute('data-focus-image') ) ? el.getAttribute('data-focus-image').split(',') : [];
                            const focusRows = el.querySelectorAll('tbody tr');

                            if( focusFields.length === focusRows.length ){

                                focusRows.forEach(function( row, i ){

                                    // mouseover
                                    row.addEventListener('mouseover',function(e){
                                        _focusImage( focusFields[i] );
                                    });

                                });

                            } else {
                                alert( 'table cannot be set up correctly - missing element on comma separated data-focus-image' );
                            }

                        }

                        // 
                        // TEXT INPUT
                        //
                        if( el.matches('.nhsuk-input') ){

                            // focus
                            el.addEventListener('focus', function(e){
                                
                                const focusTarget = e.target.getAttribute('data-focus-image');
                                if( focusTarget ){
                                    _focusImage(focusTarget);
                                }

                            });

                            
                            if(blursActive){

                                // blur
                                el.addEventListener('blur',function(){
                                    _focusImage();
                                });

                            }

                        }

                        //
                        // RADIO INPUT
                        //
                        if( el.matches('.nhsuk-radios') ){

                            const focusTarget = el.getAttribute('data-focus-image');

                            // Check inputs
                            el.querySelectorAll('.nhsuk-radios__input').forEach( function( radio ){


                                radio.addEventListener('focus',function(){
                                    _focusImage(focusTarget);
                                });

                                if(blursActive){
                                    radio.addEventListener('blur',function(){
                                        _focusImage();
                                    });
                                }


                            });

                        }

                        //
                        // TINY CHECKBOXES
                        // These appear on the Cannot process application page
                        //
                        if (el.matches('.nhsuk-checkboxes__input')) {

                        const focusTarget = el.getAttribute('data-focus-image');

                        el.addEventListener('focus', () => _focusImage(focusTarget));
                        el.addEventListener('mouseover', () => _focusImage(focusTarget));

                        if (blursActive) {
                            el.addEventListener('blur', () => _focusImage());
                            el.addEventListener('mouseout', () => _focusImage());
                        }
                        }


                        //
                        // SUMMARY LIST (WITH LINK) ROWS
                        //
                        if( el.matches('.nhsuk-summary-list .nhsuk-link') ){

                            // Set row
                            const row = el.parentElement.parentElement;

                            row.classList.add('has-focus-image');
                            row.addEventListener('mouseover',function(e){

                               if( e.target.closest('.has-focus-image') ){
                                
                                    const focusTarget = e.target.closest('.has-focus-image').querySelector('.nhsuk-link[data-focus-image]').getAttribute('data-focus-image');
                                    if( focusTarget ){
                                        _focusImage(focusTarget);
                                    }

                               }

                            });

                            if(mouseOutsActive){
                                row.addEventListener('mouseout',function(e){
                                    _focusImage();
                                });
                            }
                            

                        }

                    });

                }

                //
                // SUMMARY LIST (FOCUS IMAGE VERSION)
                // Can't use attributes on the summary list component, and there are no links to hook off on the case-rejected screens, so gonna have to do this the hard way...
                //
                const summaryLists = document.querySelectorAll('.summary-list--focus-image');

                summaryLists.forEach(function( summaryList ){
                    
                    const fieldNames = [
                        'First name',
                        'Last name',
                        'Address',
                        'Date of birth',
                        'NHS number',
                        'Telephone number',
                        'Email address',
                        "Child's due or birth date"
                    ];

                    const focusImageTags = [
                        'firstName',
                        'lastName',
                        'address',
                        'dateOfBirth',
                        'nhsNumber',
                        'telephoneNumber',
                        'emailAddress',
                        'childsDueOrBirthDate'
                    ];

                    summaryList.querySelectorAll('.nhsuk-summary-list__row').forEach( function( row ){

                        const keyValue = row.querySelector('.nhsuk-summary-list__key').innerText.trim();

                        if( fieldNames.indexOf(keyValue) > -1 ){

                            const focusTag = focusImageTags[ fieldNames.indexOf(keyValue) ];
                            row.setAttribute( 'data-focus-image', focusTag );
                            
                            row.addEventListener('mouseover',function(e){
                                _focusImage(focusTag);
                            });

                            if(mouseOutsActive){
                                row.addEventListener('mouseout',function(e){
                                    _focusImage();
                                });
                            }


                        }

                    });


                });

            }
            

            //
            // CHECK FOR FOCUSED ELEMENTS FUNCTION
            //
            function _checkForFocusedElements(){

                // Text inputs
                if( document.activeElement.matches('.nhsuk-input') ){
                    if( document.activeElement.hasAttribute('data-focus-image') ){
                        _focusImage( document.activeElement.getAttribute('data-focus-image') );
                    }
                }

                // Radios
                if( document.activeElement.matches('.nhsuk-radios__input') ){
                    if( document.activeElement.closest('.nhsuk-radios') ){
                        _focusImage( document.activeElement.closest('.nhsuk-radios').getAttribute('data-focus-image') );
                    }
                }

            }

            //
            // RESET IMAGE FUNCTION
            //
            function _resetImage(){

                console.log( '_resetImage();' );

                const expander = document.querySelector( '.expandable-image' );
                const img = expander.querySelector('.expandable-image__image');
                const viewPane = expander.querySelector('.expandable-image__inner');

                viewPane.querySelectorAll('span').forEach(function( el ){
                    el.remove();
                });

                img.removeAttribute( 'style' );
                viewPane.scrollTop = 0;
                viewPane.scrollLeft = 0;

            }

            //
            // FOCUS IMAGE FUNCTION
            //
            function _focusImage( fieldName ){


                _resetImage();

                const fieldPositions = [
                    'lastName',
                    'firstName',
                    'dateOfBirth',
                    'nhsNumber',
                    'address',
                    'addressLine2',
                    'houseNumber',
                    'street',
                    'town',
                    'postcode',
                    'emailAddress',
                    'telephoneNumber',
                    'childsDueOrBirthDate',
                    'patientSignature',
                    'healthcarePractitionerSignature',
                    'healthcarePractitionerDetails',
                    'healthcarePractitionerName',
                    'healthcarePractitionerAddress',
                    'healthcarePractitionerStamp',
                    'permanentFistula',
                    'epilepsy',
                    'diabetesMellitus',
                    'myxoedema',
                    'hypoparathyroidism',
                    'diabetesInsipidus',
                    'formsOfHypoadrenalism',
                    'myastheniaGravis',
                    'continuingPhysicalDisability',
                    'cancer'
                ];

                fieldName = ( fieldPositions.indexOf( fieldName ) > -1 ) ? fieldName : '';

                const expander = document.querySelector( '.expandable-image' );
                const img = expander.querySelector('.expandable-image__image');
                const viewPane = expander.querySelector('.expandable-image__inner');
                const div = viewPane.querySelector('div');

                const intrinsicImgWidth = img.width;
                const intrinsicImgHeight = img.height;
                const FORM_TYPE = "{{ type }}";
                const activeFields = (FORM_TYPE === 'medex') ? _fieldsMedex : _fields;

                if( fieldName ){

                    // Calculate scale of img
                    const scale = viewPane.offsetWidth / activeFields[fieldName].width;

                    const scaledImgWidth = Math.round( img.width * scale );
                    const scaledImgHeight = Math.round( img.height * scale );

                    const scaledMidPointX = Math.round( activeFields[fieldName].midPointX * scale );
                    const scaledMidPointY = Math.round( activeFields[fieldName].midPointY * scale );

                    img.setAttribute('style','height:'+scaledImgHeight+'px; width:'+scaledImgWidth+'px' );

                    // Calculate scrollPosition of viewPane
                    // !important - 32px border
                    //
                    viewPane.scrollTop = (32+scaledMidPointY) - Math.round(viewPane.clientHeight/2);
                    viewPane.scrollLeft = (32+scaledMidPointX) - Math.round(viewPane.clientWidth/2);

                    // Draw a highlight over the image
                    const highlightX = 32+Math.round(activeFields[fieldName].x * scale);
                    const highlightY = 32+Math.round(activeFields[fieldName].y * scale);
                    const highlightWidth = Math.round(activeFields[fieldName].width * scale);
                    const highlightHeight = Math.round(activeFields[fieldName].height * scale);

                    const span = document.createElement('span');
                    span.setAttribute( 'style', 'top: '+highlightY+'px; left: '+highlightX+'px; width:'+highlightWidth+'px; height: '+highlightHeight+'px;' );
                    div.insertAdjacentElement('beforeend',span);

                }

            }


            return {
                init: _init,
                focusImage: _focusImage
            }

        })();

        window.addEventListener('load',function(){
            ExpanderImage.init();
        });

    </script>






    <details class="expandable-image{{ ' ' + ( classes or '' ) }}">

        <h2 class="nhsuk-heading-m nhsuk-u-visually-hidden">Scanned application</h2>
        
        <div class="expandable-image__inner">
            <div>
               {% set imgSrc = "/assets/images/FW8-MATEX-scan.png" %}

                {% if type == "medex" %}
                {% set imgSrc = "/assets/images/FP92A-MEDEX-scan.png" %}
                {% endif %}

                <img class="expandable-image__image" src="{{ imgSrc }}" alt=""/>
            </div>
        </div>
        <summary class="expandable-image__button nhsuk-button nhsuk-button--small">
            <span class="closed">Expand image</span>
            <span class="open">Shrink image</span>
        </summary>

    </details>


    

{% endmacro %}