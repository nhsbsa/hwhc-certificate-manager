{% macro stats(statistics) %}

    {% from "card/macro.njk" import card %}

    <!-- STATS -->
    <div class="nhsuk-grid-row id-stats">


        <!-- ACCEPTED -->
        <div class="nhsuk-grid-column-one-fifth">
            {% call card({
                  clickable: false,
                  heading: statistics[0] + '',
                  headingClasses: 'nhsuk-u-font-size-64 nhsuk-u-margin-bottom-1',
                  headingVisuallyHiddenText: 'Applications accepted'
                }) %}
            <p class="nhsuk-body-s">Accepted</p>
            {% endcall %}
        </div>
        
        <!-- ON HOLD -->
        <div class="nhsuk-grid-column-one-fifth">
            {% call card({
                  clickable: false,
                  heading: statistics[1] + '',
                  headingClasses: 'nhsuk-u-font-size-64 nhsuk-u-margin-bottom-1',
                  headingVisuallyHiddenText: 'Applications placed on hold'
                }) %}
            <p class="nhsuk-body-s">On hold</p>
            {% endcall %}
        </div>

        <!-- REJECTED -->
        <div class="nhsuk-grid-column-one-fifth">
            {% call card({
                  clickable: false,
                  heading: statistics[2] + '',
                  headingClasses: 'nhsuk-u-font-size-64 nhsuk-u-margin-bottom-1',
                  headingVisuallyHiddenText: 'Applications rejected'
                }) %}
            <p class="nhsuk-body-s">Rejected</p>
            {% endcall %}
        </div>

        <!-- KFP -->
        <div class="nhsuk-grid-column-one-fifth">
            {% call card({
                  clickable: false,
                  heading: statistics[3] + '',
                  headingClasses: 'nhsuk-u-font-size-64 nhsuk-u-margin-bottom-1',
                  headingVisuallyHiddenText: 'Key from paper requested'
                }) %}
            <p class="nhsuk-body-s">KFP</p>
            {% endcall %}
        </div>

        <!-- TOTAL -->
        <div class="nhsuk-grid-column-one-fifth">
            {% call card({
                  clickable: false,
                  heading: statistics[4] + '',
                  headingClasses: 'nhsuk-u-font-size-64 nhsuk-u-margin-bottom-1',
                  headingVisuallyHiddenText: 'Total applications processed'
                }) %}
            <p class="nhsuk-body-s">Total</p>
            {% endcall %}
        </div>

    </div>

{% endmacro %}