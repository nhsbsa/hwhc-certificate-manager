{% macro notes( patient ) %}

    {% from 'nhsapp/components/timeline/macro.njk' import nhsappTimeline %}

    {% set yesterday = -1 | alterTodaysDateByNumberOfDays %}
    {% set today = 0 | alterTodaysDateByNumberOfDays %}
    {% set processorFullName = patient.processorName + ' (' + patient.processor + ')' %}

    {% if patient.certificateType === 'matex' and patient.channel === 'Paper' %}

        <!-- PAPER ROUTE -->

        {% if ( ( 10 | getRandomNumber ) === 0 ) %}
            {% set processingText = 'Application manually entered, ready for processing' %}
        {% else %}
            {% set processingText = 'Application scanned, ready for processing' %}
        {% endif %}

        {% set items = [
            {
                headingText: 'Processing',
                isPastItem: true,
                html: '<p class="nhsuk-body-s">'+processingText+'</p><span class="nhsuk-body-s">'+yesterday+', 8:30 am</span>'
            }
        ] %}

        {% if patient.status !== 'processing' %}

            <!-- REJECTED -->
            {% if patient.status === 'rejected' %}

                {% set reasonForRejection = [
                    'child has already reached their first birthday',
                    'patient is outside England',
                    'patient is under 16',
                    'patient is over 60',
                    'patient already has a valid exemption certificate'
                ] | random %}

                {% set rejectedText = '<p class="nhsuk-body-s">Application rejected because '+reasonForRejection+' by '+processorFullName+'</p>' %}

                {% set items = ( items.push({
                    headingText: 'Rejected',
                    isPastItem: true,
                    html: rejectedText + '<span class="nhsuk-body-s">'+yesterday+', 9:56 am</span>'
                }), items ) %}

            {% endif %}

            <!-- ON HOLD -->
            {% if patient.status === 'on-hold' %}

                {% set num = 2 | getRandomNumber %}
                    
                {% if num === 0 %}
                    <!-- WITH PATIENT -->

                    {% set patientReasons = [
                        "patient's date of birth",
                        "patient's telephone number",
                        "patient's email address",
                        "child's due or birth date",
                        "health professional's signature"
                    ] | randomiseAndConvertToList %}

                    {% set onHoldText = '<p class="nhsuk-body-s nhsuk-u-margin-bottom-0">Further information requested from patient by '+processorFullName+':</p>' + patientReasons %}


                {% elif num === 1 %}
                    <!-- WITH HCP -->

                    {% set hcpReasons = [
                        "patient's name",
                        "patient's address and postcode",
                        "patient's email address",
                        "patient's signature",
                        "child's due or birth date",
                        "health professional's signature",
                        "health professional's name",
                        "Part 3 of the application form"
                    ] | randomiseAndConvertToList %}

                    {% set onHoldText = '<p class="nhsuk-body-s nhsuk-u-margin-bottom-0">Further information requested from health care professional by '+processorFullName+':</p>' + hcpReasons %}

                {% elif num === 2 %}
                    <!-- RESCAN -->
                    {% set onHoldText = '<p class="nhsuk-body-s">Rescan requested by '+processorFullName+'</p>' %}
                    
                {% endif %}

                {% set items = ( items.push({
                    headingText: 'On hold',
                    isPastItem: true,
                    html: onHoldText + '<span class="nhsuk-body-s nhsuk-u-margin-bottom-0">'+yesterday+', 9:56 am</span>'
                }), items ) %}


                 {% if 2 | getRandomNumber === 0 and num === 1 %}

                    <!-- NAGGY PATIENT -->
                    {% set items = ( items.push({
                        headingText: 'Note added',
                        html: '<p class="nhsuk-body-s">Patient rang up to ask about their Matex. Advised that more information was needed from their HCP.</p><span class="nhsuk-body-s">'+yesterday+', 12:55 pm</span>'
                    }), items ) %}


                {% endif %}


                {% if 5 | getRandomNumber === 0 and num === 2 %}

                    <!-- ADD AN EXTRA PAPER KEY-IN -->
                    {% set items = ( items.push({
                        headingText: 'Note added',
                        html: '<p class="nhsuk-body-s">Literally could not see a thing. I need to check the paper.</p><span class="nhsuk-body-s">'+yesterday+', 12:55 pm</span>'
                    }), items ) %}

                    {% set onHoldText = '<p class="nhsuk-body-s">Paper form requested by '+processorFullName+'</p>' %}
                    {% set items = ( items.push({
                        headingText: 'On hold',
                        isPastItem: true,
                        html: onHoldText + '<span class="nhsuk-body-s nhsuk-u-margin-bottom-0">'+yesterday+', 12:56 pm</span>'
                    }), items ) %}


                {% endif %}





            {% endif %}


        {% endif %}




    {% else %}


        <!-- DIGITAL ROUTE -->

        {% set items = [
            {
                headingText: 'Application scanned',
                isPastItem: true,
                html: '<span class="nhsuk-body-s">'+yesterday+', 8:30 am</span>'
            }
        ] %}

    {% endif %}



    <!-- OUTPUT THE TIMELINE -->

    <div class="nhsuk-card nhsuk-card--grey">
        <div class="nhsuk-card__content">

            <div class="events-log">

                <!--

                This is written in with the JS, but only when necessary...

                <div class="menu-container">
                    <ul class="nhsuk-list">
                        <li><button class="nhsuk-u-font-size-16" aria-pressed="true"><span>All</span></button></li>
                        <li><button class="nhsuk-u-font-size-16" aria-pressed="false"><span>Notes</span></button></li>
                        <li><button class="nhsuk-u-font-size-16" aria-pressed="false"><span>Events</span></button></li>
                    </ul>
                </div>
                
                -->
                
                <div class="scroll-container">
                    {{ nhsappTimeline({
                        id: 'timeline-application',
                        items: items | reverse
                    }) }}
                </div>

            </div>

        </div>
    </div>


    <script>

        const EventLog = (function(){

            //
            // INIT FUNCTION
            //
            function _init(){

                console.log( '_init();' );

                const events = document.querySelectorAll('.nhsapp-timeline__item:not(.nhsapp-timeline__item--past)');

                if( events.length > 0 ){

                    _drawMenu();

                }

            }

            //
            // DRAW MENU FUNCTION
            //
            function _drawMenu(){

                console.log('_drawMenu();');

                const menu = document.createElement('div');
                menu.classList.add('menu-container');

                let html = '';
                html += '<ul class="nhsuk-list">';
                html += '<li><button class="nhsuk-u-font-size-16" aria-pressed="true"><span>All</span></button></li>';
                html += '<li><button class="nhsuk-u-font-size-16" aria-pressed="false"><span>Notes</span></button></li>';
                html += '<li><button class="nhsuk-u-font-size-16" aria-pressed="false"><span>Events</span></button></li>';
                html += '</ul>';

                menu.innerHTML = html;

                const eventsLog = document.querySelector('.events-log');
                eventsLog.insertAdjacentElement('afterbegin',menu);

                document.querySelectorAll('.events-log button').forEach(function(button){
                    button.addEventListener('click',function(e){
                        _toggleMenu( e.target );
                    });
                });

            }

            //
            // TOGGLE MENU FUNCTION
            //
            function _toggleMenu( button ){

                // Toggle buttons
                document.querySelectorAll('.events-log button').forEach(function(el){
                    el.setAttribute('aria-pressed','false');
                });

                button.setAttribute('aria-pressed','true');
                button.blur();

                // Toggle menu items
                const all = document.querySelectorAll('.events-log .nhsapp-timeline__item');
                const notes = document.querySelectorAll('.events-log .nhsapp-timeline__item:not(.nhsapp-timeline__item--past)');
                const events = document.querySelectorAll('.events-log .nhsapp-timeline__item--past');
              
                switch( button.innerText ){

                    case 'Notes':
                        all.forEach(function(item){
                            item.classList.remove('last-of-type');
                            item.classList.add('hidden');
                            if( !item.classList.contains('nhsapp-timeline__item--past') ){
                                item.classList.remove('hidden');
                            }
                        });
                        notes[notes.length-1].classList.add('last-of-type');
                        break;

                    case 'Events':
                        all.forEach(function(item){
                            item.classList.remove('last-of-type');
                            item.classList.add('hidden');
                            if( item.classList.contains('nhsapp-timeline__item--past') ){
                                item.classList.remove('hidden');
                            }
                            events[events.length-1].classList.add('last-of-type');
                        });
                        break;

                    default: 
                        all.forEach(function(item){
                            item.classList.remove('last-of-type');
                            item.classList.remove('hidden');
                        });
                        break;
                }

                document.querySelector('.events-log .scroll-container').scrollTo(0,0);

            }


            return {
                init: _init
            }

        })();

        document.addEventListener('DOMContentLoaded',function(){
            EventLog.init();
        });

    </script>



{% endmacro %}